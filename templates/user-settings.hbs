<form>
  <p class="settings-hint">
    Selecciona los jugadores que usarán el control móvil en lugar del mapa.
  </p>
  {{#each users}}
  <div class="form-group">
    <label class="user-toggle">
      <input type="checkbox" name="user-{{this.id}}" {{#if this.enabled}}checked{{/if}}>
      {{#if this.avatar}}<img class="user-avatar" src="{{this.avatar}}" alt="">{{/if}}
      <span>{{this.name}}</span>
    </label>
  </div>
  {{/each}}
  {{#unless users.length}}
  <p class="settings-empty">No hay jugadores disponibles.</p>
  {{/unless}}
  <div class="settings-submit">
    <button type="submit">Guardar</button>
  </div>
</form>
